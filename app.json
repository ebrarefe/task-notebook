{
  "expo": {
    "name": "Görev Defteri",
    "slug": "gorevdefteri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ebrar.gorevdefteri",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.ebrar.gorevdefteri",
      "adaptiveIcon": {
        "backgroundColor": "#F1ECE0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "READ_CALENDAR"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#294B8F"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Günün etkinliklerini görevlerinle göstermek için takvime erişim."
        }
      ]
    ],
    "owner": "efe1111",
    "extra": {
      "eas": {
        "projectId": "cf248419-90f6-4768-be74-d11a6e9e1449"
      }
    }
  }
}
